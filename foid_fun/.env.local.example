NEXT_PUBLIC_RPC=https://rpc.testnet.fluent.xyz
NEXT_PUBLIC_CHAIN_ID=20994

# --- Observability (all optional) ---
# Without a key, src/lib/analytics.ts no-ops and useReportWebVitals never
# dispatches. Set only in preview / production. DNT is respected client-side.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Supabase (board chat) ---
# URL + anon key ship to the browser (reads + realtime only — RLS blocks
# anon writes on board_messages, see sql/lock_board_messages_rls.sql).
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key is SERVER-ONLY (never NEXT_PUBLIC_*). /api/chat/send uses
# it to insert chat rows past RLS after verifying the sender's signature.
# Dashboard > Settings > API > service_role secret.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

