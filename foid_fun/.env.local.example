# Dedicated / private RPC (QuickNode, Fluent-issued, etc). SERVER-ONLY.
# MUST NOT use a NEXT_PUBLIC_* prefix — those get inlined into the browser
# bundle at build time and leak to MetaMask. See QUICKNODE_SETUP.md.
FLUENT_RPC_URL=https://rpc.testnet.fluent.xyz
# FLUENT_RPC_URL=https://<your-dedicated-quicknode-endpoint>

# Legacy NEXT_PUBLIC_* vars. Kept ONLY as transitional fallbacks for
# server-side reads. Never put the dedicated/private URL in these — they
# will ship to every browser. Prefer leaving them unset in production.
# NEXT_PUBLIC_FLUENT_RPC=https://rpc.testnet.fluent.xyz
NEXT_PUBLIC_LOREBOARD_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_LOREBOARD_BOARD_ADDRESS=0x0000000000000000000000000000000000000000
LOREBOARD_BOARD_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_LOREBOARD_VOTING_ADDRESS=0x0000000000000000000000000000000000000000
LOREBOARD_VOTING_ADDRESS=0x0000000000000000000000000000000000000000
VOTING_POWER_ADDRESS=0x0000000000000000000000000000000000000000
