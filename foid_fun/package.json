{
  "name": "foid-fun",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prebuild.js",
    "build": "NODE_OPTIONS='--max-old-space-size=2048' next build",
    "start": "NODE_OPTIONS='--max-old-space-size=1024' next start -p $PORT",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:a11y": "playwright test tests/e2e/board/a11y.spec.ts",
    "typecheck": "tsc --noEmit",
    "finalize": "ts-node --project tsconfig.scripts.json scripts/operatorFinalize.ts",
    "smoke:board": "ts-node --project tsconfig.scripts.json scripts/smoke-board-flow.ts",
    "worker:sync": "tsx scripts/loreboard-worker.ts sync",
    "worker:finalize": "tsx scripts/loreboard-worker.ts finalize",
    "worker:dry": "DRY_RUN=1 tsx scripts/loreboard-worker.ts finalize",
    "vm:smoke": "tsx scripts/loreboardVM-call.ts",
    "verify:latest": "tsx scripts/verify-latest-manifest.ts",
    "demo:one": "pnpm vm:smoke && pnpm tsx scripts/e2e-step3.ts && pnpm verify:latest",
    "e2e:board": "tsx scripts/e2e-step3-boardv1.ts",
    "debug:receipt": "tsx scripts/debug-receipt-logs.ts",
    "sync:nft": "tsx scripts/sync-live-nft.ts",
    "recover:refunds": "tsx scripts/recover-stuck-refunds.ts",
    "check:refunds": "tsx scripts/dry-run-refunds.ts",
    "auto:finalize": "tsx scripts/auto-finalize-cron.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@rainbow-me/rainbowkit": "2.1.6",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@supabase/supabase-js": "^2.81.0",
    "@tanstack/react-query": "5.51.1",
    "@wagmi/connectors": "6.2.0",
    "@wagmi/core": "2.22.1",
    "better-sqlite3": "^12.8.0",
    "bs58": "^6.0.0",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "framer-motion": "^11.0.17",
    "hash-wasm": "^4.12.0",
    "multiformats": "^13.4.1",
    "next": "14.2.35",
    "node-forge": "^1.3.1",
    "openai": "^6.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.4.1",
    "react-rnd": "^10.5.2",
    "twitter-api-v2": "^1.29.0",
    "viem": "^2.38.6",
    "wagmi": "^2.19.2",
    "web3.storage": "^4.5.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.25",
    "@types/react": "18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "happy-dom": "^20.8.9",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.13",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "5.6.3",
    "vitest": "^1.6.0"
  },
  "ts-node": {
    "project": "tsconfig.scripts.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}