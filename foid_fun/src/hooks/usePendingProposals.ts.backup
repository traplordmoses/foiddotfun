// hooks/usePendingProposals.ts
// Fetch pending proposals from the LoreboardV2 contract

import { useEffect, useState } from "react";
import { usePublicClient } from "wagmi";

const LOREBOARD_V2_ADDRESS = "0xE41B2D418C09Ea928E4F657ED2438f5D01472105" as `0x${string}`;
const VOTING_CONTRACT_ADDRESS = "0xEbf065A7ca3917BB5e669982e8C6954cC27A7075" as `0x${string}`;
const FLUENT_TESTNET_CHAIN_ID = 20993;

// Simplified ABI - you'll need to add the actual method signatures
const LOREBOARD_ABI = [
  {
    name: "getActiveProposals",
    type: "function",
    stateMutability: "view",
    inputs: [],
    outputs: [
      {
        type: "tuple[]",
        components: [
          { name: "id", type: "bytes32" },
          { name: "proposer", type: "address" },
          { name: "cid", type: "string" },
          { name: "x", type: "int256" },
          { name: "y", type: "int256" },
          { name: "w", type: "uint256" },
          { name: "h", type: "uint256" },
          { name: "submittedAt", type: "uint256" },
        ],
      },
    ],
  },
] as const;

const VOTING_ABI = [
  {
    name: "getVotes",
    type: "function",
    stateMutability: "view",
    inputs: [{ name: "proposalId", type: "bytes32" }],
    outputs: [
      { name: "yes", type: "uint256" },
      { name: "no", type: "uint256" },
    ],
  },
] as const;

export interface PendingProposal {
  id: string;
  proposer: string;
  cid: string;
  x: number;
  y: number;
  w: number;
  h: number;
  submittedAt: number;
  votesYes: bigint;
  votesNo: bigint;
  voteEndsAt: number;
  timeRemaining: number;
}

const VOTING_PERIOD_SECONDS = 72 * 60 * 60; // 72 hours

export function usePendingProposals() {
  const [proposals, setProposals] = useState<PendingProposal[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<Error | null>(null);

  const publicClient = usePublicClient({ chainId: FLUENT_TESTNET_CHAIN_ID });

  useEffect(() => {
    let alive = true;
    let intervalId: NodeJS.Timeout | null = null;

    const loadProposals = async () => {
      if (!publicClient) {
        console.log("[usePendingProposals] No public client");
        return;
      }

      try {
        console.log("[usePendingProposals] 📡 Loading pending proposals...");

        // Option 1: If you have a getActiveProposals method
        try {
          const rawProposals = await publicClient.readContract({
            address: LOREBOARD_V2_ADDRESS,
            abi: LOREBOARD_ABI,
            functionName: "getActiveProposals",
          });

          if (!alive) return;

          console.log("[usePendingProposals] ✅ Got proposals:", rawProposals.length);

          // Fetch votes for each proposal
          const proposalsWithVotes = await Promise.all(
            rawProposals.map(async (p: any) => {
              const [yes, no] = await publicClient.readContract({
                address: VOTING_CONTRACT_ADDRESS,
                abi: VOTING_ABI,
                functionName: "getVotes",
                args: [p.id],
              });

              const submittedAt = Number(p.submittedAt);
              const voteEndsAt = submittedAt + VOTING_PERIOD_SECONDS;
              const timeRemaining = Math.max(0, voteEndsAt - Math.floor(Date.now() / 1000));

              return {
                id: p.id,
                proposer: p.proposer,
                cid: p.cid,
                x: Number(p.x),
                y: Number(p.y),
                w: Number(p.w),
                h: Number(p.h),
                submittedAt,
                votesYes: yes,
                votesNo: no,
                voteEndsAt,
                timeRemaining,
              };
            })
          );

          if (alive) {
            setProposals(proposalsWithVotes);
            setError(null);
          }
        } catch (contractError) {
          // If contract method doesn't exist, fall back to event logs
          console.log("[usePendingProposals] Contract method not found, using event logs");

          // Fetch proposal events from the last 72 hours
          const currentTime = Math.floor(Date.now() / 1000);
          const startTime = currentTime - VOTING_PERIOD_SECONDS;

          // Get current block
          const latestBlock = await publicClient.getBlockNumber();

          // Estimate blocks to search (assuming ~2 second block time)
          const blocksToSearch = BigInt(Math.floor(VOTING_PERIOD_SECONDS / 2));
          const fromBlock = latestBlock - blocksToSearch;

          // Get proposal submitted events
          const logs = await publicClient.getLogs({
            address: LOREBOARD_V2_ADDRESS,
            fromBlock,
            toBlock: latestBlock,
          });

          console.log("[usePendingProposals] Found", logs.length, "proposal events");

          // TODO: Parse logs and extract proposal data
          // For now, return empty array
          if (alive) {
            setProposals([]);
            setError(null);
          }
        }
      } catch (err) {
        console.error("[usePendingProposals] ❌ Error:", err);
        if (alive) {
          setError(err instanceof Error ? err : new Error(String(err)));
        }
      } finally {
        if (alive) {
          setLoading(false);
        }
      }
    };

    loadProposals();

    // Refresh every 30 seconds to update vote counts and time remaining
    intervalId = setInterval(() => {
      void loadProposals();
    }, 30000);

    return () => {
      alive = false;
      if (intervalId) clearInterval(intervalId);
    };
  }, [publicClient]);

  return { proposals, loading, error };
}
