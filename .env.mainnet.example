# ============================================================================
#  FOID Mainnet Deployment — Environment Variables
#  Copy this to .env.mainnet and fill in your values
# ============================================================================

# Deployer / operator private key (this wallet pays gas and becomes initial operator)
OPERATOR_PK=0xYOUR_PRIVATE_KEY_HERE

# Wallet that receives all fees (loreboard proposals, swipe submissions)
# This is where your money goes. Use your personal wallet or the multisig.
FEE_RECIPIENT=0xYOUR_FEE_WALLET_HERE

# 2-of-3 multisig signers (controls all contract parameters post-deploy)
MULTISIG_SIGNER_1=0xSIGNER_1_ADDRESS
MULTISIG_SIGNER_2=0xSIGNER_2_ADDRESS
MULTISIG_SIGNER_3=0xSIGNER_3_ADDRESS

# ── Optional overrides (defaults are fine for launch) ──

# Loreboard submission fee (default: 0.001 ETH)
# SUBMISSION_FEE=1000000000000000

# Voting window in seconds (default: 259200 = 72 hours)
# VOTING_WINDOW=259200

# Swipe submission fee (default: 0.001 ETH)
# SWIPE_SUBMISSION_FEE=1000000000000000

# Swipe voting window (default: 259200 = 72 hours)
# SWIPE_VOTING_WINDOW=259200

# Voting power base weight (default: 100)
# VP_BASE_WEIGHT=100

# MiFOID holder bonus (default: 50) — not deployed in this round
# VP_MIFOID_BONUS=50
