# ============================================================================
#  FOID Mainnet Deployment — Environment Variables
#  Copy this to .env.mainnet and fill in your values
#  Chain: Fluent Mainnet (ID 25363) — https://rpc.fluent.xyz
# ============================================================================

# ── Deployer / Operator ──
# Private key for the wallet that pays gas and becomes initial operator
OPERATOR_PK=0xYOUR_PRIVATE_KEY_HERE

# Wallet that receives all fees (loreboard proposals = 0.001 ETH each)
FEE_RECIPIENT=0xYOUR_FEE_WALLET_HERE

# ── 2-of-3 Multisig Signers ──
# Controls all contract parameters post-deploy
MULTISIG_SIGNER_1=0xSIGNER_1_ADDRESS
MULTISIG_SIGNER_2=0xSIGNER_2_ADDRESS
MULTISIG_SIGNER_3=0xSIGNER_3_ADDRESS

# ── Goldsky Subgraph ──
# GOLDSKY_MAINNET_API_KEY=your_goldsky_api_key

# ── Render Hosting ──
# RENDER_API_KEY=your_render_api_key

# ── Optional Overrides (defaults are fine for launch) ──

# Loreboard submission fee (default: 0.001 ETH = 1000000000000000 wei)
# SUBMISSION_FEE=1000000000000000

# Voting window in seconds (default: 259200 = 72 hours)
# VOTING_WINDOW=259200

# Swipe submission fee (default: 0.001 ETH)
# SWIPE_SUBMISSION_FEE=1000000000000000

# Voting power base weight (default: 100)
# VP_BASE_WEIGHT=100

# MiFOID holder bonus (default: 50) — not deployed in this round
# VP_MIFOID_BONUS=50

# ── Deploy Dependencies ──
# Set after DeployMainnetCore.s.sol completes:
# STREAK_VOTING_POWER_ADDRESS=0x...
# PRAYER_MIRROR_ADDRESS=0x8ff39c2a78FaF7d655e4Dab03076Cb26C97007FF

# Set after DeployMultisig.s.sol completes:
# MULTISIG_ADDRESS=0x...
